# ===========================================
# Generator Bot Configuration
# ===========================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# ===========================================
# CORE BOT SETTINGS
# ===========================================

# Telegram Bot API Token (get from @BotFather)
BOT_TOKEN=your_bot_token_here

# Operating mode: TEST or PROD
# TEST mode uses SHEET_ID_TEST, PROD uses SHEET_ID_PROD
MODE=TEST

# Bot registration status: ON or OFF
# When OFF, new users cannot register
BOT_STATUS=ON

# ===========================================
# GOOGLE SHEETS
# ===========================================

# Production Google Sheet ID (from URL: docs.google.com/spreadsheets/d/{SHEET_ID}/...)
SHEET_ID_PROD=your_production_sheet_id

# Test/Development Google Sheet ID
SHEET_ID_TEST=your_test_sheet_id

# Main worksheet name (default: "ЛЮТИЙ" - February in Ukrainian)
SHEET_NAME=ЛЮТИЙ

# Legacy logs worksheet name
LOGS_SHEET_NAME=ПОДІЇ

# Enable Google Sheets synchronization at runtime (1=yes, 0=no)
# Set to 0 for faster local testing without Sheets API
SHEETS_RUNTIME_ENABLED=1

# Path to Google Service Account JSON file
# Download from Google Cloud Console
SERVICE_ACCOUNT_PATH=service_account.json

# ===========================================
# DATABASE
# ===========================================

# Database backend: sqlite or postgres
DB_BACKEND=sqlite

# SQLite database file path (used when DB_BACKEND=sqlite)
SQLITE_PATH=generator.db

# PostgreSQL connection string (required when DB_BACKEND=postgres)
# Format: postgresql://user:password@host:port/database
# POSTGRES_DSN=postgresql://botuser:botpass@localhost:5432/generator_bot

# PostgreSQL admin DSN for database creation (optional)
# POSTGRES_ADMIN_DSN=postgresql://postgres:adminpass@localhost:5432/postgres

# PostgreSQL Connection Pool Settings
PG_POOL_MIN_SIZE=2
PG_POOL_MAX_SIZE=10
PG_POOL_TIMEOUT=30
PG_POOL_MAX_IDLE=300

# ===========================================
# REDIS (for FSM Storage)
# ===========================================

# Enable Redis for bot state storage (1=yes, 0=no)
# When disabled, uses in-memory storage (lost on restart)
REDIS_ENABLED=0

# Redis connection URL (required when REDIS_ENABLED=1)
REDIS_URL=redis://localhost:6379/0

# ===========================================
# LOGGING
# ===========================================

# Log file path
LOG_FILE=bot.log

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Maximum log file size in bytes (default: 10MB)
LOG_MAX_BYTES=10485760

# Number of backup log files to keep
LOG_BACKUP_COUNT=5

# ===========================================
# TIMEZONE & WORK SCHEDULE
# ===========================================

# Timezone for operations (IANA timezone database format)
TIMEZONE=Europe/Kyiv

# Work day start time (HH:MM format, 24-hour)
WORK_START=07:30

# Work day end time (HH:MM format, 24-hour)
WORK_END=20:30

# Morning briefing time (HH:MM format, 24-hour)
BRIEF_TIME=07:30

# Stop reminder: minutes before work end to send reminder
STOP_REMINDER_MIN=15

# ===========================================
# FUEL CONFIGURATION
# ===========================================

# Main generator fuel consumption rate (liters per hour)
FUEL_CONSUMPTION=5.3

# Legacy alias for FUEL_CONSUMPTION (backward compatibility)
# FUEL_RATE=5.3

# Emergency generator fuel consumption (liters per hour)
# If not set, defaults to FUEL_CONSUMPTION
EMERGENCY_FUEL_CONSUMPTION=5.5

# Fuel alert threshold (liters)
# Alert admins when fuel level drops below this value
FUEL_ALERT_THRESHOLD=40.0

# Fuel alert cooldown (minutes)
# Minimum time between fuel alerts to avoid spam
FUEL_ALERT_COOLDOWN_MIN=60

# ===========================================
# MAINTENANCE INTERVALS
# ===========================================

# Oil change interval (motor hours)
OIL_CHANGE_INTERVAL=100

# Spark plug change interval (motor hours)
SPARK_CHANGE_INTERVAL=100

# General maintenance interval (motor hours)
MAINTENANCE_INTERVAL=300

# Legacy parameter (backward compatibility)
# OIL_LIMIT=100

# ===========================================
# ACCESS CONTROL
# ===========================================

# Admin Telegram user IDs (comma-separated)
# Get your ID from @userinfobot
ADMINS=123456789,987654321

# User whitelist (comma-separated Telegram IDs)
# Leave empty to allow all users (when BOT_STATUS=ON)
# USERS=111111111,222222222

# ===========================================
# ADVANCED OPTIONS
# ===========================================

# These are typically not needed but available for customization

# Custom sheet names for specific months (Ukrainian)
# SHEET_NAME_JAN=СІЧЕНЬ
# SHEET_NAME_FEB=ЛЮТИЙ
# SHEET_NAME_MAR=БЕРЕЗЕНЬ
# ... etc

# ===========================================
# DOCKER-SPECIFIC (when using docker-compose)
# ===========================================

# When using docker-compose.yml, PostgreSQL connection:
# POSTGRES_DSN=postgresql://botuser:botpass@postgres:5432/generator_bot
# REDIS_URL=redis://redis:6379/0

# ===========================================
# DEVELOPMENT & TESTING
# ===========================================

# For local development without external dependencies:
# MODE=TEST
# DB_BACKEND=sqlite
# SQLITE_PATH=generator_test.db
# REDIS_ENABLED=0
# SHEETS_RUNTIME_ENABLED=0  # Disable Sheets API calls
# LOG_LEVEL=DEBUG
