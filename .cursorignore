# Спеціальний ігнор-файл для AI-асистентів, щоб не засмічувати їх контекст

# Бази даних (бінарники)
*.db
*.sqlite
*.sqlite3

# Конфігурація та Інфраструктура (чутливі дані)
.env
.env.local
service_account.json
*.pem
*.key

# Віртуальні середовища та Кеш
venv/
env/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/

# Логи бота (можуть бути дуже великими)
*.log
logs/

# Git та системні файли
.git/
.idea/
.vscode/
